POSTGRES_USER=faqears
POSTGRES_PASSWORD=faqears
POSTGRES_DB=postgres

AUTH_GRPC_ADDR=:50051
AUTH_DB_URL=postgres://faqears:faqears@postgres:5432/auth?sslmode=disable
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=720h
AUTH_KAFKA_BROKERS=kafka:9092
AUTH_LOG_LEVEL=info

USER_GRPC_ADDR=:50052
USER_DB_URL=postgres://faqears:faqears@postgres:5432/users?sslmode=disable
USER_KAFKA_BROKERS=kafka:9092
USER_KAFKA_GROUP_ID=user-service
USER_LOG_LEVEL=info
